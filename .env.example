# Required for Render/PostgreSQL. Use the Internal Database URL from Render.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
AI_API_KEY=replace_with_your_provider_key
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
A2A_BASE_PATH=/a2a
# Set this to the exact public URL after deployment, including /a2a/
A2A_BASE_URL=https://YOUR-SERVICE.onrender.com/a2a/
# Optional for local SQLite development only; ignored when DATABASE_URL is set.
DATABASE_PATH=./mailroom.sqlite3